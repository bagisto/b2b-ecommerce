{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:admin && npm run build:shop",
        "build:admin": "vite build --config vite.admin.config.js",
        "build:shop": "vite build --config vite.shop.config.js",
        "dev:admin": "vite --config vite.admin.config.js",
        "dev:shop": "vite --config vite.shop.config.js",
        "publishables": "npm run build && node scripts/copy-builds.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "laravel-vite-plugin": "^1.0",
        "tailwindcss": "^4.0.0",
        "vite": "^6.4.2"
    }
}
